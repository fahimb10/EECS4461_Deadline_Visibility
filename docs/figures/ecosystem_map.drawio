        <mxCell id="banner" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px; color: #ffffff;&quot;&gt;BOUNDED COMPUTATIONAL MODEL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;color: #E0F2FE;&quot;&gt;Mesa Discrete-Event Simulation Engine [E3]&lt;/font&gt;" vertex="1">
