          <mxGeometry height="706" width="1026" x="34" y="62" as="geometry" />
        </mxCell>
        <mxCell id="prod" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;spacingTop=15;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Content Producers&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;Instructors &amp;amp; TAs [E1]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&quot;left&quot;&gt;• Post Assignments (6)&lt;br&gt;• Post Resources (4)&lt;br&gt;• Post Announcements:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- Low: 6 items&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- Med: 12 items&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;- High: 24 items&lt;br&gt;• Set Due Dates&lt;br&gt;&lt;br&gt;&lt;b&gt;Status:&lt;/b&gt; Observed / Synth [E4]&lt;/div&gt;" vertex="1">
          <mxGeometry height="282" width="224" x="64" y="112" as="geometry" />
        </mxCell>
        <mxCell id="ext" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FCA5A5;strokeWidth=2;dashed=1;verticalAlign=top;spacingTop=15;" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px; color: #991B1B;&quot;&gt;External Channels&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;b&gt;&lt;font style=&quot;color: #DC2626;&quot;&gt;(Outside Model Boundary)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&quot;left&quot; style=&quot;color: #7F1D1D;&quot;&gt;Secondary Alerts in Reality:&lt;br&gt;• Automated Email Digests&lt;br&gt;• Mobile Push Notifications&lt;br&gt;• Forum Discussion Alerts&lt;br&gt;• Synced Calendar Feeds&lt;br&gt;&lt;br&gt;&lt;i&gt;Omission: Students may receive off-feed alerts in practice.&lt;/i&gt;&lt;/div&gt;" vertex="1">
