        <mxCell id="sub1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BAE6FD;strokeWidth=1.5;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px; color: #0369A1;&quot;&gt;1. Content Pool &amp;amp; Stepping Loop (30 Days) [E4]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• 30 Daily Time Steps (Days 0 to 29)&lt;br&gt;• 6 Assessments: [(1,7), (5,12), (10,16), (12,17), (19,25), (23,29)]&lt;br&gt;• 4 Static Resources | Traffic Tiers: Low (6), Med (12), High (24)" vertex="1">
          <mxGeometry height="92" width="422" x="341" y="184" as="geometry" />
        </mxCell>
        <mxCell id="sub2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BAE6FD;strokeWidth=1.5;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px; color: #0369A1;&quot;&gt;2. Sorting &amp;amp; Ordering Rules (Comparison)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;div align=&quot;left&quot;&gt;&lt;b&gt;Baseline Rule [E1]:&lt;/b&gt; Pure reverse-chronological (newest post day first).&lt;br&gt;&lt;hr&gt;&lt;b&gt;&lt;font color=&quot;#0C4A6E&quot;&gt;Alternative Rule (Pinning) [Synthetic]:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Assessments with days remaining &amp;lt;= 3 pinned to top (by due date)&lt;br&gt;• Remaining viewport slots filled reverse-chronologically&lt;/div&gt;" vertex="1">
          <mxGeometry height="152" width="422" x="341" y="294" as="geometry" />
        </mxCell>
        <mxCell id="sub3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BAE6FD;strokeWidth=1.5;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px; color: #0369A1;&quot;&gt;3. Viewport Window Filter (Top 5 Slots) [E2]&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Fixed &quot;above-the-fold&quot; desktop capacity = 5 slots&lt;br&gt;• Ranks 0–4 are visible = True; Ranks 5+ are below the fold" vertex="1">
          <mxGeometry height="92" width="422" x="341" y="464" as="geometry" />
        </mxCell>
        <mxCell id="sub4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#FACC15;strokeWidth=1.5;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px; color: #854D0E;&quot;&gt;4. Tracked Output Metrics (DataCollector)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• Urgent Assessment Visibility: % of 24 urgent events in top 5&lt;br&gt;• Displaced Recent Announcements: Count of items &amp;lt;= 2 days old pushed out" vertex="1">
          <mxGeometry height="92" width="422" x="341" y="574" as="geometry" />
        </mxCell>
        <mxCell id="cons" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=2;verticalAlign=top;spacingTop=15;" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Content Consumers&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;York Students [E1]&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&quot;left&quot;&gt;• Limited Daily Attention&lt;br&gt;• Load Course Homepage&lt;br&gt;• Inspect Top Feed Slots&lt;br&gt;• Seek Urgent Deadlines and Recent Updates&lt;br&gt;&lt;br&gt;&lt;b&gt;Status:&lt;/b&gt; Observed Setting [E1]&lt;/div&gt;" vertex="1">
