        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Figure 1: Ecosystem Map - LMS Course Feed Arrangement&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;i&gt;EECS 4461 Computational Inquiry: Reverse-Chronological vs. Deadline-Pinned Ordering&lt;/i&gt;" vertex="1">
